# === CONFIGURACAO DA IA (GEMINI) | inicio ===
# Copie este arquivo para config/gemini.env e coloque as suas chaves.
# Chave em: https://aistudio.google.com/apikey
# Ordem = ordem de uso: a principal responde; as reservas (_2 ate _9) so entram se a anterior falhar.
# Local: o `npm run dev` le config/gemini.env a cada mensagem (nao precisa reiniciar).
# Remoto: rode `npm run ia:publicar-chave` para enviar as chaves como secrets do Cloudflare Pages.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash

# Reservas opcionais
GEMINI_API_KEY_2=
GEMINI_MODELO_2=
GEMINI_API_KEY_3=
GEMINI_MODELO_3=
# === CONFIGURACAO DA IA (GEMINI) | fim ===
